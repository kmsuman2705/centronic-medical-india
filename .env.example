# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Content manager (admin) settings -------------------------------------------------
# Password used to sign in at /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD="change-this-admin-password"

# Secret used to sign admin session cookies. Use a long random string.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Email used by Caddy for Let's Encrypt certificate notices.
SITE_EMAIL="admin@centronicmedical.com"

# Set to "true" only when the site is served over HTTPS.
# docker-compose.yml sets this to "true" automatically; local dev can use "false".
COOKIE_SECURE="false"

# Optional server port (defaults to 3000).
PORT="3000"
